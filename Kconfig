# DJI-Remote-nRFConnect application configuration

menu "DJI Remote"

module = DJI_REMOTE
module-str = DJI Remote
source "subsys/logging/Kconfig.template.log_config"

menu "GPS Configuration"

config GPS_UART_NUM
    int "UART port number for GPS"
    default 0
    help
        Kept from the original project so gps_reader.c compiles unchanged.
        On Zephyr the port is selected by the `gps-uart` devicetree alias,
        so this value is only used in log messages.

config GPS_UART_BAUD_RATE
    int "GPS UART baud rate"
    default 9600
    help
        Baud rate for GPS UART communication (ATGM336H defaults to 9600).

config GPS_UART_TX_PIN
    int "GPS UART TX GPIO pin"
    default 9
    help
        Documented here for parity with the original project; the actual pin
        comes from the devicetree (P0.09).

config GPS_UART_RX_PIN
    int "GPS UART RX GPIO pin"
    default 10
    help
        Documented here for parity with the original project; the actual pin
        comes from the devicetree (P0.10).

endmenu

endmenu

source "Kconfig.zephyr"
